PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/stocksense?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# In development only, return the reset OTP in the API response if email is not configured.
DEV_RETURN_OTP=true
# Set all three to send real password-reset emails (mandatory in production).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_username
# SMTP_PASS=your_password
# SMTP_FROM=StockSense <noreply@example.com>
